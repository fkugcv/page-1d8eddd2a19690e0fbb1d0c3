6,18,.09);padding:0 1.3rem}\nsummary{cursor:pointer;padding:1.1rem 0;font-weight:600;list-style:none}\nsummary::-webkit-details-marker{display:none}\ndetails p{padding:0 0 1.15rem;color:#4A3226;border-top:1px solid #E4D5C6;padding-top:.8rem}\n.foot{border-top:1px solid #C9B8A8;padding:1.4rem 4vw 2.2rem;font-family:system-ui,\"PingFang SC\",\"Microsoft YaHei\",sans-serif;font-size:13px;color:#6A5346;display:flex;justify-content:space-between;gap:1rem;flex-wrap:wrap}\n@media(max-width:860px){\n.hero{grid-template-columns:1fr;grid-template-areas:\"meta\" \"title\" \"dek\" \"body\" \"quote\";min-height:0;padding:1.4rem 5vw 2rem}\n.hero nav{flex-direction:row;flex-wrap:wrap;gap:.4rem .9rem}\nh1{font-size:3.6rem}\n.catalog{grid-template-columns:1fr}\n.wrap{padding:2.2rem 0}\n.foot{padding:1.2rem 5vw 2rem}\n}\n</style><main>\n<section class=\"hero\">\n<div class=\"hero-meta\">\n<p class=\"kicker\">第七期 · 深棕 / 薄荷</p>\n<nav>\n<a href=\"#catalog\">目录</a>\n<a href=\"#how\">使用</a>\n<a href=\"#plans\">订户</a>\n<a href=\"#clients\">客户端</a>\n<a href=\"#faq\">问答</a>\n</nav>\n<p class=\"note\">先读篇目。再看档位。下载地址本页不写。</p>\n</div>\n<div class=\"hero-title\">\n<h1>Beryl</h1>\n</div>\n<p class=\"hero-dek\">一份按期更新的物件笔记。颜色在前。名字在后。</p>\n<p class=\"hero-body\">本页只做三件事。列出当期篇目。说明订户档。交代阅读入口。没有口号。没有额外身份。</p>\n<aside class=\"hero-quote\">\n<blockquote>先看见切面，再决定要不要收藏。</blockquote>\n<p class=\"attr\">刊首引言</p>\n</aside>\n</section>\n\n<section class=\"wrap\" id=\"catalog\">\n<h2>当期目录</h2>\n<p class=\"lead\">四篇。都短。从器物表面写起。</p>\n<div class=\"catalog\">\n<div>\n<article class=\"piece\">\n<h3>褐釉碗的口沿</h3>\n<p>釉停在唇边。手感比颜色先到。记录一次停顿，不写产地神话。</p>\n</article>\n<article class=\"piece\">\n<h3>薄荷糖纸上的折痕</h3>\n<p>纸会响。折痕是时间留下的线。本篇只追这一条线。</p>\n</article>\n<article class=\"piece\">\n<h3>深夜的木桌纹理</h3>\n<p>灯偏暖。木纹偏干。把桌面当成一页未裁的纸。</p>\n</article>\n<article class=\"piece\">\n<h3>一枚绿柱石的切面笔记</h3>\n<p>刊名来自矿物。本文只谈切面、折射与命名的先后。</p>\n</article>\n</div>\n<aside class=\"sidebox\">\n<h3>阅读顺序</h3>\n<p>从上到下。不必跳。读完一篇就停也可以。</p>\n<p>订户档不改变篇目。只改变能翻到哪一年。</p>\n</aside>\n</div>\n</section>\n\n<section class=\"wrap\" id=\"how\">\n<h2>使用说明</h2>\n<p class=\"lead\">五步。做完第一步就能决定要不要往下。</p>\n<div class=\"steps\">\n<article class=\"step\">\n<b>01</b>\n<h3>打开目录</h3>\n<p>看标题。看自己还想不想读第二句。不想，就离开。</p>\n</article>\n<article class=\"step\">\n<b>02</b>\n<h3>对照订户档</h3>\n<p>单册、长期、编辑室。价格写在卡片上。年付另列一行。</p>\n</article>\n<article class=\"step\">\n<b>03</b>\n<h3>核客户端名称</h3>\n<p>到下方客户端区。只核对名字。本页不给安装包。</p>\n</article>\n<article class=\"step\">\n<b>04</b>\n<h3>从第一篇进入</h3>\n<p>登录后回到目录。不要从中间页开始。顺序是编辑定的。</p>\n</article>\n<article class=\"step\">\n<b>05</b>\n<h3>先查问答</h3>\n<p>问号放在最后一组。仍不清楚，再写信。不要先猜。</p>\n</article>\n</div>\n</section>\n\n<section class=\"wrap\" id=\"plans\">\n<h2>订户档</h2>\n<p class=\"lead\">三档。单列。一张读完再翻下一张。</p>\n<article class=\"plan\">\n<h3>单册</h3>\n<p class=\"price\">¥15 / 月</p>\n<p class=\"year\">按年付 ¥150 / 年</p>\n<ul>\n<li>当期全部篇目</li>\n<li>两席同步阅读</li>\n<li>句段标记</li>\n<li>刊末索引</li>\n</ul>\n</article>\n<article class=\"plan featured\">\n<p class=\"badge\">本期主推</p>\n<h3>长期</h3>\n<p class=\"price\">¥35 / 月</p>\n<p class=\"year\">按年付 ¥350 / 年</p>\n<ul>\n<li>当年完整档案</li>\n<li>五席同步阅读</li>\n<li>边栏批注与导出</li>\n<li>刊次预告</li>\n<li>编辑回信靠前处理</li>\n</ul>\n</article>\n<article class=\"plan\">\n<h3>编辑室</h3>\n<p class=\"price\">¥85 / 月</p>\n<p class=\"year\">按年付 ¥850 / 年</p>\n<ul>\n<li>库内可查篇目</li>\n<li>二十席共用目录</li>\n<li>共同批注</li>\n<li>对口联络人</li>\n<li>可约定专题目录</li>\n</ul>\n</article>\n</section>\n\n<section class=\"wrap\" id=\"clients\">\n<h2>客户端</h2>\n<p class=\"lead\">入口有名字。本页没有包。也没有商店链接。</p>\n<div class=\"clients\">\n<article class=\"client\">\n<h3>桌面阅读器</h3>\n<p class=\"muted\">名称应写作 Beryl。请在你常用的桌面应用来源里核对开发者信息。核对前不要安装。地址留空。</p>\n<p><a href=\"#\">#</a></p>\n</article>\n<article class=\"client\">\n<h3>移动阅读器</h3>\n<p class=\"muted\">名称同样是 Beryl。系统名单本页不列。兼容性不作承诺。以商店页当时显示为准。</p>\n<p><a href=\"#\">#</a></p>\n</article>\n<article class=\"client\">\n<h3>网页栏</h3>\n<p class=\"muted\">把本页加入书签即可。无扩展。无附加组件。不提供下载。</p>\n<p><a href=\"#\">#</a></p>\n</article>\n</div>\n</section>\n\n<section class=\"wrap\" id=\"faq\">\n<h2>常见问题</h2>\n<p class=\"lead\">点开一条。读完再点下一条。</p>\n<div class=\"faq-list\">\n<details>\n<summary>Beryl 是什么？</summary>\n<p>一份按期更新的物件笔记。矿物名只作刊名。不引申成别的服务。</p>\n</details>\n<details>\n<summary>订户档买的是什么？</summary>\n<p>阅读范围与席位。单册看当期。长期看当年。编辑室看库，并共用目录。</p>\n</details>\n<details>\n<summary>为什么没有下载按钮？</summary>\n<p>本页不托管安装包。也不填写未核对的地址。链接因此为 #。</p>\n</details>\n<details>\n<summary>如何开始？</summary>\n<p>先读目录。选定一档。再去客户端区核名称。打开后从第一篇读。</p>\n</details>\n<details>\n<summary>编辑室如何共用？</summary>\n<p>一人建目录。其余人按席位进入。专题目录需另行约定。细节以当期说明为准。</p>\n</details>\n</div>\n</section>\n</main>\n<footer class=\"foot\">\n<span>Beryl · 第七期</span>\n<span>深棕作底。薄荷作标记。</span>\n</footer>",
